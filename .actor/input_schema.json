{
    "title": "Energy Intelligence Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "mode": {
            "title": "Run Mode",
            "type": "string",
            "description": "Select the operation mode.",
            "default": "status",
            "editor": "select",
            "enum": [
                "status",
                "hourly",
                "weekly",
                "all"
            ],
            "enumTitles": [
                "Check Status (Default)",
                "Ingest Hourly Grid Stats",
                "Ingest Weekly Outages",
                "Ingest All Data"
            ]
        },
        "local_reference": {
            "title": "Use Local Reference Files",
            "type": "boolean",
            "description": "If enabled, uses local CSV files from 'reference/' directory instead of fetching from Eskom URL. Useful for debugging or backfilling.",
            "default": false
        }
    },
    "required": [
        "mode"
    ]
}